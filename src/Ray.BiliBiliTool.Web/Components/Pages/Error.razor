@page "/Error"
@using System.Diagnostics

<PageTitle>错误</PageTitle>

<h1 class="text-danger">出错了。</h1>
<h2 class="text-danger">处理您的请求时发生错误。</h2>

@if (ShowRequestId)
{
    <p>
        <strong>请求 ID：</strong> <code>@RequestId</code>
    </p>
}

<h3>开发模式</h3>
<p>
    切换到 <strong>开发</strong> 环境将显示有关该错误的更详细信息。
</p>
<p>
    <strong>生产部署中不应启用开发环境。</strong>
    否则可能会向最终用户显示异常中的敏感信息。
    本地调试时，可将环境变量 <strong>ASPNETCORE_ENVIRONMENT</strong> 设置为
    <strong>Development</strong> 并重启应用，以启用 <strong>开发</strong> 环境。
</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}
